{
  "$description": "OpenBitFun light semantic theme migrated from the built-in light Appearance.",
  "component": {
    "button": {
      "$description": "Button-specific state colors. Keep shared action colors stable for other controls and preserve contrast-mode feedback.",
      "content": { "$type": "color", "$value": "{color.action.neutral.content}" },
      "textContent": { "$type": "color", "$value": "{ref.color.cyan.600}" },
      "textContentHover": { "$type": "color", "$value": "{ref.color.cyan.700}" },
      "textContentDisabled": { "$type": "color", "$value": "{color.accent.disabled}" },
      "outlineBorder": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "outlineBorderInteractive": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "fillBackground": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "fillBackgroundHover": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "fillBackgroundPressed": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "primaryBackground": { "$type": "color", "$value": "rgba(20, 17, 14, 0.92)" },
      "primaryBackgroundHover": { "$type": "color", "$value": "rgba(42, 38, 34, 0.72)" },
      "primaryBackgroundPressed": { "$type": "color", "$value": "rgba(20, 17, 14, 1)" },
      "primaryContentDisabled": { "$type": "color", "$value": "rgba(255, 253, 248, 0.35)" }
    },
    "empty": {
      "media": {
        "$description": "Opaque low-emphasis color for decorative empty-state artwork, matching muted content at 35% over the tertiary empty-state surface without alpha accumulation.",
        "$type": "color",
        "$value": "color-mix(in srgb, {color.content.muted} 35%, {color.surface.tertiary})"
      }
    }
  },
  "color": {
    "composer": {
      "border": { "$type": "color", "$value": "{color.field.border}" },
      "contextBackground": { "$type": "color", "$value": "rgba(42, 38, 34, 0.04)" }
    },
    "numberBadge": {
      "background": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" }
    },
    "actionCard": {
      "background": { "$type": "color", "$value": "rgba(42, 38, 34, 0.04)" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "{ref.color.neutral.100}" },
      "panel": { "$type": "color", "$value": "{ref.color.neutral.50}" },
      "raised": { "$type": "color", "$value": "{ref.color.neutral.50}" },
      "scene": {
        "$description": "Primary content scene behind editors, terminals, and full-page work areas.",
        "$type": "color",
        "$value": "{ref.color.neutral.50}"
      },
      "workbench": {
        "$description": "Application workbench surrounding content scenes and panels.",
        "$type": "color",
        "$value": "{ref.color.neutral.150}"
      },
      "tertiary": {
        "$description": "Opaque low-emphasis container surface for persistent grouped content.",
        "$type": "color",
        "$value": "{ref.color.neutral.150}"
      },
      "chrome": {
        "$description": "Structural application chrome behind persistent navigation and window controls.",
        "$type": "color",
        "$value": "{ref.color.neutral.150}"
      },
      "subtle": {
        "$description": "Translucent local tint for transient feedback and small inset details; not a persistent container surface.",
        "$type": "color",
        "$value": "rgba(42, 38, 34, 0.04)"
      }
    },
    "overlay": {
      "scrim": {
        "$description": "Backdrop veil behind blocking modal surfaces.",
        "$type": "color",
        "$value": "rgba(42, 38, 34, 0.22)"
      }
    },
    "keyHint": {
      "content": { "$type": "color", "$value": "{color.content.secondary}" },
      "background": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" }
    },
    "scrollbar": {
      "thumb": { "$type": "color", "$value": "rgba(42, 38, 34, 0.22)" },
      "thumbHover": { "$type": "color", "$value": "rgba(42, 38, 34, 0.32)" }
    },
    "content": {
      "caption": { "$description": "Menu and navigation group captions; carries final opacity without attenuating primary text again.", "$type": "color", "$value": "rgba(42, 38, 34, 0.68)" },
      "primary": { "$type": "color", "$value": "rgba(42, 38, 34, 0.90)" },
      "secondary": { "$type": "color", "$value": "rgba(42, 38, 34, 0.72)" },
      "muted": { "$type": "color", "$value": "{ref.color.neutral.600}" },
      "disabled": { "$type": "color", "$value": "rgba(42, 38, 34, 0.32)" },
      "inverse": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "onDark": {
        "$description": "Content that must remain legible on a known dark or image-backed surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.0}"
      },
      "onLight": {
        "$description": "Content that must remain legible on a known light surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.1000}"
      },
      "requiredIndicator": {
        "$description": "Required-field marker text, darkened to the seal-blue 600 step so it stays AA-legible on paper surfaces.",
        "$type": "color",
        "$value": "{ref.color.cyan.600}"
      }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{ref.color.cyan.500}" },
      "hover": { "$type": "color", "$value": "{ref.color.cyan.600}" },
      "disabled": { "$type": "color", "$value": "rgba(83, 125, 150, 0.32)" },
      "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 5%, transparent)" },
      "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 9%, transparent)" },
      "surfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 15%, transparent)" },
      "borderSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 25%, transparent)" },
      "border": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 40%, transparent)" },
      "secondary": {
        "$description": "Secondary product emphasis for paired accents and identity gradients.",
        "$type": "color",
        "$value": "{ref.color.purple.600}"
      },
      "secondaryHover": { "$type": "color", "$value": "{ref.color.purple.700}" },
      "secondarySurface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 9%, transparent)" },
      "secondarySurfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 15%, transparent)" },
      "secondaryBorder": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 25%, transparent)" }
    },
    "identity": {
      "assistant": {
        "$description": "Named assistant identity used where it must remain distinct from the primary and secondary product accents.",
        "content": { "$type": "color", "$value": "{ref.color.pink.600}" },
        "contentHover": { "$type": "color", "$value": "{ref.color.pink.700}" },
        "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 5%, transparent)" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 9%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 15%, transparent)" }
      },
      "globalSearch": {
        "$description": "Stable wayfinding identities for the six primary Global Search actions; these colors do not imply status.",
        "newSession": { "$type": "color", "$value": "{ref.color.red.650}" },
        "openBrowser": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "openTerminal": { "$type": "color", "$value": "{color.action.neutral.content}" },
        "openProject": { "$type": "color", "$value": "{ref.color.cyan.500}" },
        "newProject": { "$type": "color", "$value": "{ref.color.blue.575}" },
        "openFiles": { "$type": "color", "$value": "{ref.color.purple.450}" }
      },
      "harness": {
        "$description": "Stable identities for the four selectable Agent Harness profiles.",
        "minimal": { "$type": "color", "$value": "{ref.color.purple.550}" },
        "standard": { "$type": "color", "$value": "{ref.color.green.550}" },
        "ultimate": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "creative": { "$type": "color", "$value": "{ref.color.blue.550}" }
      }
    },
    "link": {
      "default": { "$type": "color", "$value": "{ref.color.cyan.600}" },
      "hover": { "$type": "color", "$value": "{ref.color.cyan.700}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "rgba(42, 38, 34, 0.10)" },
      "default": { "$type": "color", "$value": "rgba(42, 38, 34, 0.18)" },
      "strong": { "$type": "color", "$value": "rgba(42, 38, 34, 0.36)" }
    },
    "action": {
      "neutral": {
        "border": { "$type": "color", "$value": "rgba(42, 38, 34, 0.06)" },
        "content": { "$type": "color", "$value": "{color.content.primary}" },
        "contentDisabled": { "$type": "color", "$value": "{color.content.disabled}" },
        "fillBorder": { "$type": "color", "$value": "{color.action.neutral.surface}" },
        "surface": { "$type": "color", "$value": "rgba(42, 38, 34, 0.06)" },
        "surfaceHover": { "$type": "color", "$value": "rgba(42, 38, 34, 0.09)" },
        "surfacePressed": { "$type": "color", "$value": "rgba(42, 38, 34, 0.12)" }
      },
      "primary": {
        "background": { "$type": "color", "$value": "{ref.color.navy.950}" },
        "hover": { "$type": "color", "$value": "{ref.color.neutral.900}" },
        "pressed": { "$type": "color", "$value": "{ref.color.neutral.1000}" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.0}" }
      },
      "secondary": {
        "background": { "$type": "color", "$value": "{ref.color.neutral.50}" },
        "hover": { "$type": "color", "$value": "rgba(42, 38, 34, 0.10)" },
        "pressed": { "$type": "color", "$value": "rgba(42, 38, 34, 0.14)" },
        "content": { "$type": "color", "$value": "{color.content.primary}" }
      },
      "quiet": {
        "hover": { "$type": "color", "$value": "{ref.color.neutral.200}" },
        "pressed": { "$type": "color", "$value": "rgba(42, 38, 34, 0.12)" },
        "content": { "$type": "color", "$value": "{color.content.secondary}" }
      }
    },
    "selection": {
      "surface": {
        "$description": "Persistent neutral selection fill, distinct from transient pressed feedback.",
        "$type": "color",
        "$value": "{color.action.neutral.surfaceHover}"
      }
    },
    "field": {
      "groupBackground": { "$description": "Grouped form tint; independent of opaque tertiary containers and transient subtle feedback.", "$type": "color", "$value": "rgba(42, 38, 34, 0.04)" },
      "borderActive": { "$description": "Input and SearchField editing border, distinct from the stronger generic focus indicator used by other controls.", "$type": "color", "$value": "{color.field.borderHover}" },
      "placeholder": { "$description": "Empty field hints and decorative adornments; distinct from general secondary prose.", "$type": "color", "$value": "rgba(42, 38, 34, 0.68)" },
      "background": { "$type": "color", "$value": "{ref.color.neutral.50}" },
      "backgroundHover": { "$type": "color", "$value": "{color.field.background}" },
      "border": { "$type": "color", "$value": "rgba(42, 38, 34, 0.12)" },
      "borderHover": { "$type": "color", "$value": "rgba(42, 38, 34, 0.24)" },
      "borderFocus": { "$type": "color", "$value": "{ref.color.neutral.550}" }
    },
    "control": {
      "highlight": {
        "$description": "Shared active-control highlight for checked switches and prominent launchers. High-contrast modes may replace this pair.",
        "background": { "$type": "color", "$value": "{ref.color.cyan.500}" },
        "content": { "$type": "color", "$value": "{color.content.onLight}" }
      },
      "launcher": {
        "$description": "Shell-edge launcher states: neutral at rest, then cyan-tinted with cyan content on hover and press.",
        "background": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
        "backgroundHover": { "$type": "color", "$value": "color-mix(in srgb, {color.control.highlight.background} 20%, transparent)" },
        "backgroundPressed": { "$type": "color", "$value": "color-mix(in srgb, {color.control.highlight.background} 30%, transparent)" },
        "content": { "$type": "color", "$value": "{color.action.neutral.content}" },
        "contentHover": { "$type": "color", "$value": "{ref.color.cyan.600}" },
        "contentPressed": { "$type": "color", "$value": "{ref.color.cyan.600}" },
        "contentDisabled": { "$type": "color", "$value": "{color.action.neutral.contentDisabled}" }
      },
      "switch": {
        "track": { "$type": "color", "$value": "{color.action.neutral.surfacePressed}" },
        "trackChecked": { "$type": "color", "$value": "{color.control.highlight.background}" },
        "thumb": { "$type": "color", "$value": "{ref.color.neutral.0}" }
      }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{ref.color.cyan.600}" }
    },
    "codeChange": {
      "$description": "Stable code-change accents shared by diff lines and compact addition/deletion counts.",
      "added": { "$type": "color", "$value": "{ref.color.green.550}" },
      "removed": { "$type": "color", "$value": "{ref.color.red.650}" }
    },
    "codeDiff": {
      "$description": "Read-only code comparisons: turquoise additions, coral removals, separate line/gutter/word layers, and syntax colors. These renderer roles intentionally differ from product status and Git-summary colors.",
      "foreground": { "$type": "color", "$value": "{ref.color.gray.900}" },
      "lineNumber": { "$type": "color", "$value": "{ref.color.neutral.750}" },
      "gutterBorder": { "$type": "color", "$value": "{ref.color.neutral.0}" },
      "added": {
        "marker": { "$type": "color", "$value": "{ref.color.green.450}" },
        "line": { "$type": "color", "$value": "{ref.color.green.75}" },
        "gutter": { "$type": "color", "$value": "{ref.color.green.60}" },
        "word": { "$type": "color", "$value": "{ref.color.green.150}" }
      },
      "removed": {
        "marker": { "$type": "color", "$value": "{ref.color.red.450}" },
        "line": { "$type": "color", "$value": "{ref.color.red.75}" },
        "gutter": { "$type": "color", "$value": "{ref.color.red.65}" },
        "word": { "$type": "color", "$value": "{ref.color.red.150}" }
      },
      "syntax": {
        "comment": { "$type": "color", "$value": "{ref.color.neutral.600}" },
        "punctuation": { "$type": "color", "$value": "{ref.color.neutral.600}" },
        "keyword": { "$type": "color", "$value": "{ref.color.pink.550}" },
        "declaration": { "$type": "color", "$value": "{ref.color.purple.500}" },
        "function": { "$type": "color", "$value": "{ref.color.purple.650}" },
        "string": { "$type": "color", "$value": "{ref.color.green.625}" },
        "number": { "$type": "color", "$value": "{ref.color.cyan.600}" },
        "property": { "$type": "color", "$value": "{ref.color.amber.625}" },
        "variable": { "$type": "color", "$value": "{ref.color.amber.600}" },
        "operator": { "$type": "color", "$value": "{ref.color.cyan.700}" }
      }
    },
    "status": {
      "info": {
        "emphasis": { "$description": "Clear blue status emphasis, sharing the existing creative-action blue anchor.", "$type": "color", "$value": "{ref.color.blue.550}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 76%, {ref.color.neutral.1000})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 30%, transparent)" }
      },
      "success": {
        "emphasis": { "$description": "Status icons and short emphasis share the code-change anchor; use content for readable text.", "$type": "color", "$value": "{color.codeChange.added}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 68%, {ref.color.neutral.1000})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 30%, transparent)" }
      },
      "warning": {
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 54%, {ref.color.neutral.1000})" },
        "emphasis": {
          "$description": "Short warning-state emphasis using the product orange anchor; use warning content for longer text.",
          "$type": "color",
          "$value": "{ref.color.amber.625}"
        },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 30%, transparent)" }
      },
      "danger": {
        "emphasis": { "$description": "Status icons and short emphasis share the code-change anchor; use content for readable text.", "$type": "color", "$value": "{color.codeChange.removed}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 80%, {ref.color.neutral.1000})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 30%, transparent)" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 2px rgba(42, 38, 34, 0.05)" },
    "sm": { "$value": "0 2px 4px rgba(42, 38, 34, 0.06)" },
    "base": { "$value": "0 4px 8px rgba(42, 38, 34, 0.08)" },
    "lg": { "$value": "0 8px 16px rgba(42, 38, 34, 0.10)" },
    "xl": { "$value": "0 12px 24px rgba(42, 38, 34, 0.12)" },
    "raised": { "$value": "{shadow.sm}" },
    "composer": { "$value": "0 2px 12px rgba(42, 38, 34, 0.08)" },
    "menu": { "$value": "0 4px 20px rgba(42, 38, 34, 0.12)" },
    "overlay": { "$value": "0 4px 20px rgba(42, 38, 34, 0.12)" },
    "accentGlow": {
      "$description": "Layered emphasis glow derived from the active accent.",
      "$value": "0 12px 32px color-mix(in srgb, {color.accent.hover} 25%, transparent), 0 6px 16px color-mix(in srgb, {color.accent.default} 18%, transparent), 0 3px 8px rgba(42, 38, 34, 0.12)"
    },
    "innerHighlight": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.08)" },
    "innerHighlightHover": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.24)" }
  },
  "effect": {
    "blur": {
      "subtle": { "$type": "filter", "$value": "blur(4px) saturate(1.02)" },
      "base": { "$type": "filter", "$value": "blur(8px) saturate(1.05)" },
      "medium": { "$type": "filter", "$value": "blur(12px) saturate(1.2)" }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.55 },
    "hover": { "$value": 0.75 },
    "focus": { "$value": 0.9 },
    "muted": { "$value": "{opacity.hover}" }
  }
}
