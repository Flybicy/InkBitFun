{
  "$description": "OpenBitFun dark semantic theme migrated from the built-in dark Appearance.",
  "component": {
    "button": {
      "$description": "Button-specific state colors. Keep shared action colors stable for other controls and preserve contrast-mode feedback.",
      "content": { "$type": "color", "$value": "{color.action.neutral.content}" },
      "textContent": { "$type": "color", "$value": "{color.accent.default}" },
      "textContentHover": { "$type": "color", "$value": "{ref.color.cyan.400}" },
      "textContentDisabled": { "$type": "color", "$value": "{color.accent.disabled}" },
      "outlineBorder": { "$type": "color", "$value": "{color.action.neutral.border}" },
      "outlineBorderInteractive": { "$type": "color", "$value": "{color.action.neutral.border}" },
      "fillBackground": { "$type": "color", "$value": "{color.action.neutral.surface}" },
      "fillBackgroundHover": { "$type": "color", "$value": "{color.action.neutral.surfaceHover}" },
      "fillBackgroundPressed": { "$type": "color", "$value": "{color.action.neutral.surfacePressed}" },
      "primaryBackground": { "$type": "color", "$value": "{color.action.primary.background}" },
      "primaryBackgroundHover": { "$type": "color", "$value": "{color.action.primary.hover}" },
      "primaryBackgroundPressed": { "$type": "color", "$value": "{color.action.primary.pressed}" },
      "primaryContentDisabled": { "$type": "color", "$value": "{color.action.neutral.contentDisabled}" }
    },
    "empty": {
      "media": {
        "$description": "Opaque low-emphasis color for decorative empty-state artwork, matching muted content at 35% over the tertiary empty-state surface without alpha accumulation.",
        "$type": "color",
        "$value": "color-mix(in srgb, {color.content.muted} 35%, {color.surface.tertiary})"
      }
    }
  },
  "color": {
    "composer": {
      "border": { "$type": "color", "$value": "{color.field.border}" },
      "contextBackground": { "$type": "color", "$value": "{color.surface.subtle}" }
    },
    "numberBadge": {
      "background": { "$type": "color", "$value": "{color.action.neutral.surface}" }
    },
    "actionCard": {
      "background": { "$type": "color", "$value": "{color.action.neutral.surface}" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "{ref.color.neutral.950}" },
      "panel": { "$type": "color", "$value": "{ref.color.neutral.900}" },
      "raised": { "$type": "color", "$value": "{ref.color.neutral.900}" },
      "scene": {
        "$description": "Primary content scene behind editors, terminals, and full-page work areas.",
        "$type": "color",
        "$value": "{color.surface.panel}"
      },
      "workbench": {
        "$description": "Application workbench surrounding content scenes and panels.",
        "$type": "color",
        "$value": "{color.surface.canvas}"
      },
      "tertiary": {
        "$description": "Opaque low-emphasis container surface for persistent grouped content.",
        "$type": "color",
        "$value": "{color.surface.canvas}"
      },
      "chrome": {
        "$description": "Structural application chrome surface when it differs from content scenes.",
        "$type": "color",
        "$value": "{color.surface.canvas}"
      },
      "subtle": {
        "$description": "Translucent local tint for transient feedback and small inset details; not a persistent container surface.",
        "$type": "color",
        "$value": "rgba(240, 232, 216, 0.07)"
      }
    },
    "overlay": {
      "scrim": {
        "$description": "Backdrop veil behind blocking modal surfaces.",
        "$type": "color",
        "$value": "rgba(13, 11, 9, 0.62)"
      }
    },
    "keyHint": {
      "content": { "$type": "color", "$value": "{color.content.muted}" },
      "background": { "$type": "color", "$value": "{color.action.neutral.surface}" }
    },
    "scrollbar": {
      "thumb": { "$type": "color", "$value": "rgba(240, 232, 216, 0.22)" },
      "thumbHover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.32)" }
    },
    "content": {
      "caption": { "$description": "Menu and navigation group captions; carries final opacity without attenuating primary text again.", "$type": "color", "$value": "{color.content.muted}" },
      "primary": { "$type": "color", "$value": "{ref.color.neutral.200}" },
      "secondary": { "$type": "color", "$value": "{ref.color.neutral.350}" },
      "muted": { "$type": "color", "$value": "{ref.color.neutral.450}" },
      "disabled": { "$type": "color", "$value": "{ref.color.neutral.750}" },
      "inverse": { "$type": "color", "$value": "{ref.color.neutral.950}" },
      "onDark": {
        "$description": "Content that must remain legible on a known dark or image-backed surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.0}"
      },
      "onLight": {
        "$description": "Content that must remain legible on a known light surface.",
        "$type": "color",
        "$value": "{ref.color.neutral.1000}"
      },
      "requiredIndicator": {
        "$description": "Required-field marker text, lifted to the seal-blue 425 step so it stays AA-legible on ink surfaces.",
        "$type": "color",
        "$value": "{ref.color.cyan.425}"
      }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{ref.color.cyan.425}" },
      "hover": { "$type": "color", "$value": "{ref.color.cyan.500}" },
      "disabled": { "$type": "color", "$value": "rgba(100, 137, 160, 0.32)" },
      "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 5%, transparent)" },
      "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 9%, transparent)" },
      "surfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 15%, transparent)" },
      "borderSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 25%, transparent)" },
      "border": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.default} 40%, transparent)" },
      "secondary": {
        "$description": "Secondary product emphasis for paired accents and identity gradients.",
        "$type": "color",
        "$value": "{ref.color.purple.500}"
      },
      "secondaryHover": { "$type": "color", "$value": "{ref.color.purple.600}" },
      "secondarySurface": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 9%, transparent)" },
      "secondarySurfaceStrong": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 15%, transparent)" },
      "secondaryBorder": { "$type": "color", "$value": "color-mix(in srgb, {color.accent.secondary} 25%, transparent)" }
    },
    "identity": {
      "assistant": {
        "$description": "Named assistant identity used where it must remain distinct from the primary and secondary product accents.",
        "content": { "$type": "color", "$value": "{ref.color.pink.400}" },
        "contentHover": { "$type": "color", "$value": "{ref.color.pink.300}" },
        "surfaceSubtle": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 5%, transparent)" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 9%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.identity.assistant.content} 15%, transparent)" }
      },
      "globalSearch": {
        "$description": "Stable wayfinding identities for the six primary Global Search actions; these colors do not imply status.",
        "newSession": { "$type": "color", "$value": "{ref.color.red.650}" },
        "openBrowser": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "openTerminal": { "$type": "color", "$value": "{color.action.neutral.content}" },
        "openProject": { "$type": "color", "$value": "{ref.color.cyan.500}" },
        "newProject": { "$type": "color", "$value": "{ref.color.blue.575}" },
        "openFiles": { "$type": "color", "$value": "{ref.color.purple.450}" }
      },
      "harness": {
        "$description": "Stable identities for the four selectable Agent Harness profiles.",
        "minimal": { "$type": "color", "$value": "{ref.color.purple.550}" },
        "standard": { "$type": "color", "$value": "{ref.color.green.550}" },
        "ultimate": { "$type": "color", "$value": "{ref.color.amber.550}" },
        "creative": { "$type": "color", "$value": "{ref.color.blue.400}" }
      }
    },
    "link": {
      "default": { "$type": "color", "$value": "{ref.color.cyan.425}" },
      "hover": { "$type": "color", "$value": "{ref.color.cyan.400}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "rgba(240, 232, 216, 0.12)" },
      "default": { "$type": "color", "$value": "rgba(240, 232, 216, 0.18)" },
      "strong": { "$type": "color", "$value": "rgba(240, 232, 216, 0.30)" }
    },
    "action": {
      "neutral": {
        "border": { "$type": "color", "$value": "rgba(240, 232, 216, 0.16)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.350}" },
        "contentDisabled": { "$type": "color", "$value": "{ref.color.neutral.750}" },
        "fillBorder": { "$type": "color", "$value": "{color.action.neutral.surface}" },
        "surface": { "$type": "color", "$value": "rgba(240, 232, 216, 0.08)" },
        "surfaceHover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.11)" },
        "surfacePressed": { "$type": "color", "$value": "rgba(240, 232, 216, 0.14)" }
      },
      "primary": {
        "background": { "$type": "color", "$value": "rgba(240, 232, 216, 0.14)" },
        "hover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.20)" },
        "pressed": { "$type": "color", "$value": "rgba(240, 232, 216, 0.17)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.100}" }
      },
      "secondary": {
        "background": { "$type": "color", "$value": "rgba(240, 232, 216, 0.05)" },
        "hover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.08)" },
        "pressed": { "$type": "color", "$value": "rgba(240, 232, 216, 0.11)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.200}" }
      },
      "quiet": {
        "hover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.06)" },
        "pressed": { "$type": "color", "$value": "rgba(240, 232, 216, 0.09)" },
        "content": { "$type": "color", "$value": "{ref.color.neutral.350}" }
      }
    },
    "selection": {
      "surface": {
        "$description": "Persistent neutral selection fill, distinct from transient pressed feedback.",
        "$type": "color",
        "$value": "{color.action.neutral.surfaceHover}"
      }
    },
    "field": {
      "groupBackground": { "$description": "Grouped form tint; independent of opaque tertiary containers and transient subtle feedback.", "$type": "color", "$value": "{color.surface.tertiary}" },
      "borderActive": { "$type": "color", "$value": "{color.field.borderFocus}" },
      "placeholder": { "$type": "color", "$value": "{color.content.muted}" },
      "background": { "$type": "color", "$value": "{ref.color.neutral.900}" },
      "backgroundHover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.06)" },
      "border": { "$type": "color", "$value": "rgba(240, 232, 216, 0.16)" },
      "borderHover": { "$type": "color", "$value": "rgba(240, 232, 216, 0.22)" },
      "borderFocus": { "$type": "color", "$value": "{ref.color.neutral.550}" }
    },
    "control": {
      "highlight": {
        "$description": "Shared active-control highlight for checked switches and prominent launchers. High-contrast modes may replace this pair.",
        "background": { "$type": "color", "$value": "{ref.color.cyan.500}" },
        "content": { "$type": "color", "$value": "{color.content.onLight}" }
      },
      "launcher": {
        "$description": "Shell-edge launcher states: neutral at rest, then cyan-tinted with cyan content on hover and press.",
        "background": { "$type": "color", "$value": "{color.action.neutral.surfacePressed}" },
        "backgroundHover": { "$type": "color", "$value": "color-mix(in srgb, {color.control.highlight.background} 20%, transparent)" },
        "backgroundPressed": { "$type": "color", "$value": "color-mix(in srgb, {color.control.highlight.background} 30%, transparent)" },
        "content": { "$type": "color", "$value": "{color.action.neutral.content}" },
        "contentHover": { "$type": "color", "$value": "{ref.color.cyan.300}" },
        "contentPressed": { "$type": "color", "$value": "{ref.color.cyan.300}" },
        "contentDisabled": { "$type": "color", "$value": "{color.action.neutral.contentDisabled}" }
      },
      "switch": {
        "track": { "$type": "color", "$value": "{ref.color.neutral.750}" },
        "trackChecked": { "$type": "color", "$value": "{color.control.highlight.background}" },
        "thumb": { "$type": "color", "$value": "{ref.color.neutral.0}" }
      }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{color.accent.default}" }
    },
    "codeChange": {
      "$description": "Stable code-change accents shared by diff lines and compact addition/deletion counts.",
      "added": { "$type": "color", "$value": "{ref.color.green.400}" },
      "removed": { "$type": "color", "$value": "{ref.color.red.300}" }
    },
    "codeDiff": {
      "$description": "Read-only diff colors retain their turquoise/coral identity with brighter syntax and layered dark surfaces.",
      "foreground": { "$type": "color", "$value": "{color.content.primary}" },
      "lineNumber": { "$type": "color", "$value": "{ref.color.neutral.350}" },
      "gutterBorder": { "$type": "color", "$value": "{color.surface.panel}" },
      "added": {
        "marker": { "$type": "color", "$value": "{ref.color.green.300}" },
        "line": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.added.marker} 8%, {color.surface.panel})" },
        "gutter": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.added.marker} 5%, {color.surface.panel})" },
        "word": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.added.marker} 22%, {color.surface.panel})" }
      },
      "removed": {
        "marker": { "$type": "color", "$value": "{ref.color.red.200}" },
        "line": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.removed.marker} 8%, {color.surface.panel})" },
        "gutter": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.removed.marker} 5%, {color.surface.panel})" },
        "word": { "$type": "color", "$value": "color-mix(in srgb, {color.codeDiff.removed.marker} 22%, {color.surface.panel})" }
      },
      "syntax": {
        "comment": { "$type": "color", "$value": "{ref.color.neutral.450}" },
        "punctuation": { "$type": "color", "$value": "{ref.color.neutral.350}" },
        "keyword": { "$type": "color", "$value": "{ref.color.pink.450}" },
        "declaration": { "$type": "color", "$value": "{ref.color.purple.410}" },
        "function": { "$type": "color", "$value": "{ref.color.purple.400}" },
        "string": { "$type": "color", "$value": "{ref.color.green.400}" },
        "number": { "$type": "color", "$value": "{ref.color.cyan.300}" },
        "property": { "$type": "color", "$value": "{ref.color.amber.450}" },
        "variable": { "$type": "color", "$value": "{ref.color.amber.400}" },
        "operator": { "$type": "color", "$value": "{ref.color.cyan.425}" }
      }
    },
    "status": {
      "info": {
        "emphasis": { "$description": "Clear blue status emphasis, sharing the existing creative-action blue anchor.", "$type": "color", "$value": "{ref.color.blue.400}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 50%, {ref.color.neutral.0})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.info.emphasis} 30%, transparent)" }
      },
      "success": {
        "emphasis": { "$description": "Status icons and short emphasis share the code-change anchor; use content for readable text.", "$type": "color", "$value": "{color.codeChange.added}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 50%, {ref.color.neutral.0})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.success.emphasis} 30%, transparent)" }
      },
      "warning": {
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 60%, {ref.color.neutral.0})" },
        "emphasis": {
          "$description": "Short warning-state emphasis using the product orange anchor; use warning content for longer text.",
          "$type": "color",
          "$value": "{ref.color.amber.500}"
        },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.warning.emphasis} 30%, transparent)" }
      },
      "danger": {
        "emphasis": { "$description": "Status icons and short emphasis share the code-change anchor; use content for readable text.", "$type": "color", "$value": "{color.codeChange.removed}" },
        "content": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 40%, {ref.color.neutral.0})" },
        "surface": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 10%, transparent)" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {color.status.danger.emphasis} 30%, transparent)" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 2px rgba(13, 11, 9, 0.9)" },
    "sm": { "$value": "0 2px 4px rgba(13, 11, 9, 0.8)" },
    "base": { "$value": "0 4px 8px rgba(13, 11, 9, 0.7)" },
    "lg": { "$value": "0 8px 16px rgba(13, 11, 9, 0.6)" },
    "xl": { "$value": "0 12px 24px rgba(13, 11, 9, 0.5)" },
    "raised": { "$value": "{shadow.sm}" },
    "composer": { "$value": "0 2px 6px rgba(13, 11, 9, 0.32)" },
    "menu": { "$value": "0 4px 10px rgba(13, 11, 9, 0.48)" },
    "overlay": { "$value": "0 4px 20px rgba(13, 11, 9, 0.48)" },
    "accentGlow": {
      "$description": "Layered emphasis glow derived from the active accent.",
      "$value": "0 12px 32px color-mix(in srgb, {color.accent.hover} 25%, transparent), 0 6px 16px color-mix(in srgb, {color.accent.default} 18%, transparent), 0 3px 8px rgba(0, 0, 0, 0.12)"
    },
    "innerHighlight": { "$value": "inset 0 1px 0 rgba(240, 232, 216, 0.07)" },
    "innerHighlightHover": { "$value": "inset 0 1px 0 rgba(240, 232, 216, 0.20)" }
  },
  "effect": {
    "blur": {
      "subtle": { "$type": "filter", "$value": "blur(4px) saturate(1.05)" },
      "base": { "$type": "filter", "$value": "blur(8px) saturate(1.1)" },
      "medium": { "$type": "filter", "$value": "blur(12px) saturate(1.2)" }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.6 },
    "hover": { "$value": 0.8 },
    "focus": { "$value": 0.9 },
    "muted": { "$value": "{opacity.hover}" }
  }
}
